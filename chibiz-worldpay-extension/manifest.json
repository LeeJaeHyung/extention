{
  "manifest_version": 3,
  "name": "차이비즈 월드페이 자동 결제 (운영)",
  "short_name": "차이비즈 월드페이",
  "version": "0.7.0",
  "description": "차이비즈 관리자 웹 «결제 링크 받기»·«월드페이 결제 시험»·서버 자동 결제 작업으로 연 1688 결제 페이지에서만 월드페이(跨境宝)를 고르고 결제 버튼을 누릅니다. 시험 작업에서는 관리자 웹에 저장한 비밀번호를 비밀번호 창에 1회 자동 입력합니다. 0.7.0: 1688 이 월드페이를 미리 선택한 채 열어도 통화 탭이 그려질 때까지 기다린 뒤 판단(CURRENCY_UNKNOWN 오탐 수정).",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.chibiz.co.kr/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "차이비즈 월드페이 자동 결제",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3001/*"
      ],
      "js": [
        "src/config.js",
        "src/admin-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://air.1688.com/app/ctf-page/payment-cashier-pc-air/*"
      ],
      "js": [
        "src/config.js",
        "src/core.js",
        "src/page.js",
        "src/cashier-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.alipay.com/*"
      ],
      "js": [
        "src/config.js",
        "src/core.js",
        "src/password-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.1688.com/*"
      ],
      "js": [
        "src/config.js",
        "src/core.js",
        "src/result-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}