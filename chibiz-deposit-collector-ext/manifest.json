{
  "manifest_version": 3,
  "name": "차이비즈 입금 수집",
  "short_name": "차이비즈 입금",
  "version": "0.1.3",
  "description": "하나은행 빠른조회 화면에서 관리자가 계좌 정보를 넣고 [실행]을 누르면, 10~15분마다 어제~오늘 입금내역을 다시 조회해 읽고 같은 PC의 입금 에이전트(127.0.0.1:18080)에 저장합니다. 비밀번호는 읽지 않습니다.",
  "minimum_chrome_version": "116",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:18080/*",
    "http://localhost:18080/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "차이비즈 입금 수집 — 하나은행 빠른조회 탭에서 [실행]"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kebhana.com/flex/quick/*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.kebhana.com/flex/quick/*"
      ],
      "js": [
        "src/config.js",
        "src/bank-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}